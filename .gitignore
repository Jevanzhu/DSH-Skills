# Node / 依赖树（本仓零 npm 依赖，但 npm 仍会建出这个目录）
node_modules/

# 日志（npm 与门禁运行期产物）
*.log
npm-debug.log*

# 环境变量（本地凭据不入库；出现模板文件时用 !.env.example 开反例外）
.env
.env.*
!.env.example

# macOS 元数据垃圾（SMB 挂载也会产生，绝不进 git）
._*
.DS_Store

# 编辑器 / 工具壳：工具状态，不是源码
.claude/
.codex/
.vscode/
.zcode/
.zcode-share/

# `.agents/` 是安装位置而不是源码位置（见 README「结构」）。
# 误落在这里的副本若被提交，就成了与 skills/ 并列的第二份源码。
.agents/

# 手工 bootstrap 演练的临时目标：落在仓根；测试自身用 os.tmpdir()，不落仓内
/tmp-harness-*/

{
  "scan": ["skills", "scripts"],
  "labels": [
    { "name": "日期戳", "pattern": "\\d{4}-\\d{2}-\\d{2}" },
    { "name": "年月戳", "pattern": "\\d{4}\\s*年\\s*\\d{1,2}\\s*月" },
    { "name": "轮次", "pattern": "第\\s*(?:\\d{1,3}|[一二三四五六七八九十百]{1,3})\\s*轮" },
    { "name": "批次括注", "pattern": "[（(]\\s*批\\s*\\d{1,3}" }
  ],
  "residue": [
    { "name": "括注被切空", "pattern": "（\\s*）" },
    { "name": "括注只剩破折号", "pattern": "（\\s*[-—–]+\\s*）" }
  ]
}

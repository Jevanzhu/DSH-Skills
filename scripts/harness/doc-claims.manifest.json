      "command": ["node", "skills/dsh-project-harness/scripts/run-gates.ts", "text", "--list"],
      "byLines": true,
      "expect": "atLeast",
      "pattern": "`text` 模式（(\\d+) 道）"
    },
    {
      "name": "doc-quick 模式下限",
      "kind": "count",
      "doc": "README.md",
      "command": ["node", "skills/dsh-project-harness/scripts/run-gates.ts", "doc-quick", "--list"],
      "byLines": true,
      "expect": "atLeast",
      "pattern": "`doc-quick`（(\\d+) 道）"
    },
    {
      "name": "技能目录",
      "kind": "list",
      "doc": "README.md",
      "command": ["node", "-e", "for (const entry of require('fs').readdirSync('skills', { withFileTypes: true })) if (entry.isDirectory()) console.log(entry.name)"]
    },
    {
      "name": "发行版本",
      "kind": "list",
      "doc": "README.md",
      "command": ["node", "-e", "console.log(require('fs').readFileSync('skills/dsh-project-harness/VERSION', 'utf8').trim())"]
    },
    {
      "name": "Node 下限",
      "kind": "count",
      "doc": "skills/dsh-project-harness/SKILL.md",
      "command": ["node", "-e", "console.log(/[>]=?(\\d+)/.exec(require('./package.json').engines.node)[1])"],
      "expect": "equal",
      "pattern": "Node ≥ (\\d+)"
    }
  ]
